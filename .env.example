# RSYWX API configuration (private / server-side only)
# Local backend checkout (serves the full surface incl. /blogs/*):
RSYWX_API_BASE_URL=http://localhost:8000/api/v1
# Production:
# RSYWX_API_BASE_URL=https://api.rsywx.com/api/v1

# Shared API key, sent as the X-API-Key header (never exposed to the browser).
RSYWX_API_KEY=your-api-key-here

# Book covers are served by the frontend itself.
COVERS_BASE_URL=/covers
